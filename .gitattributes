# Default: let git infer text vs binary via content heuristics
* text=auto

# Snapshot artifacts must stay LF-only on every platform so
# JsonSerializer (always LF) matches what git checks out on Windows.
tests/__snapshots__/**/*.json  eol=lf

# Preserve authentic line endings for VB / C# line-ending-sensitive artefacts
*.cs           text eol=lf
*.csproj       text eol=lf
*.sln          text eol=lf
*.props        text eol=lf
*.json         text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.md           text eol=lf
*.xml          text eol=lf
*.axaml        text eol=lf
*.editorconfig text eol=lf

# Binaries
*.png          binary
*.jpg          binary
*.ico          binary
*.dll          binary
*.exe          binary
*.xlsx         binary
