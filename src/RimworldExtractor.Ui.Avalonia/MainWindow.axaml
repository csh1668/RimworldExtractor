<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RimworldExtractor.Ui.Avalonia.ViewModels"
        xmlns:views="using:RimworldExtractor.Ui.Avalonia.Views"
        x:Class="RimworldExtractor.Ui.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="RimWorld Extractor"
        Width="900"
        Height="700"
        MinWidth="700"
        MinHeight="500">

  <Grid RowDefinitions="*">
    <TabControl Grid.Row="0"
                SelectedIndex="{Binding SelectedTabIndex}">

      <TabItem Header="Extract">
        <views:ExtractView DataContext="{Binding Extract}"
                           Margin="8" />
      </TabItem>

      <TabItem Header="Settings">
        <views:SettingsView DataContext="{Binding Settings}"
                            Margin="8" />
      </TabItem>

    </TabControl>
  </Grid>
</Window>
